# デプロイ用環境変数テンプレート
# コピーして .env.deploy として使用: cp .env.deploy.example .env.deploy

# 必須: GCPプロジェクトID
GCP_PROJECT_ID=your-gcp-project-id

# リージョン（デフォルト: asia-northeast1）
GCP_REGION=asia-northeast1

# Artifact Registry リポジトリ名（デフォルト: docker）
GAR_REPO=docker

# API CORS許可オリジン（カンマ区切り）
# Cloud Run公開用フロントエンドURLを追加してください。
# 例: https://web-service-xxxxx-asia-northeast1.run.app
# 開発時: http://localhost:3000
CORS_ALLOW_ORIGINS=*,http://localhost:3000

# Cloud Run Service Account（任意）
API_SERVICE_ACCOUNT=api-sa@your-gcp-project-id.iam.gserviceaccount.com
WEB_SERVICE_ACCOUNT=api-sa@your-gcp-project-id.iam.gserviceaccount.com
WORKER_SERVICE_ACCOUNT=worker-sa@your-gcp-project-id.iam.gserviceaccount.com

#（任意）APIを先にデプロイしたくない場合にWebのみデプロイ時に使うURL
# GCP_API_URL=https://api-service-xxxxx-asia-northeast1.run.app
